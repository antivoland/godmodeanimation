FROM nvidia/cuda:12.1.0-runtime-ubuntu18.04

COPY . .

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=~/.cache/apt apt update
RUN --mount=type=cache,target=~/.cache/apt apt -y install python3.8
RUN --mount=type=cache,target=~/.cache/apt apt -y install python3-pip
RUN --mount=type=cache,target=~/.cache/apt apt -y install python3.8-venv
RUN --mount=type=cache,target=~/.cache/apt apt -y install make
RUN --mount=type=cache,target=~/.cache/apt apt -y install ffmpeg

RUN ln -s /usr/bin/python3.8 /usr/bin/python
RUN ln -s /usr/bin/pip3 /usr/bin/pip

RUN --mount=type=cache,target=~/.cache/app make clean venv

ENTRYPOINT ["make", "run"]

